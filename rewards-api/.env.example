# Stripe payments -- both blank until a real Stripe account is connected.
# The app boots and its health check passes without these; /checkout/start
# and the webhook return a 503 with a clear message until they're set.
# A completed Checkout payment is both the purchase AND the COPPA
# verifiable-parental-consent step (the FTC's own "check a form of
# payment" method) -- no separate Identity/KYB step in this flow.
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# Printify -- fulfills every made-to-order Shop item. Blank until a real
# Printify account exists; until then a paid order's address is stored and
# left for manual handling in the admin dashboard (same graceful-degrade
# behaviour as the Stripe keys above). The token is a Personal Access
# Token (order-write scope) from Printify > My Account > Connections >
# API tokens -- NOT a Shopify token. The shop id is the numeric id of the
# Printify shop the token can see.
PRINTIFY_API_TOKEN=
PRINTIFY_SHOP_ID=

# The reward box price, in cents. See app/config.py for the cost
# breakdown this was sized against.
REWARD_BOX_PRICE_CENTS=1000

# Where Stripe sends a Shop buyer back after Checkout -- the reward box
# still returns to REWARDS_PAGE_URL (defaults correctly, not listed here);
# every other product (see app/products.py) returns here instead.
SHOP_PAGE_URL=https://edusystems-code.github.io/LittleSproutStories/shop.html

# Single shared admin password -- there's only one admin (solo operation).
# Pick something real before deploying; nothing works without it, but
# leaving it blank is safe (the admin routes just reject every login).
ADMIN_PASSWORD=
# Random long string used to sign the admin session cookie. Generate one
# with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_SESSION_SECRET=dev-only-change-me

# How long a fulfilled request's mailing address is kept before being
# scrubbed (see app/services/retention.py).
RETENTION_DAYS_AFTER_SENT=90

# Relative to this directory (where uvicorn/alembic run from). The file
# is gitignored; only data/.gitkeep is tracked.
DATABASE_URL=sqlite:///./data/rewards.db

# Comma-separated list of origins allowed to call this API. The live
# LittleSprout Stories site by default; add a local dev origin here too
# if testing rewards.html from a local server.
ALLOWED_ORIGINS=https://edusystems-code.github.io
